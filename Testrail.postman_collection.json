		{
			"name": "Get cases",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Визуализация данных в HTML таблице\r",
							"var template = `\r",
							"    <table>\r",
							"        <tr>\r",
							"            <th>Id</th>\r",
							"            <th>Title</th>\r",
							"            <th>Estimate</th>\r",
							"        </tr>\r",
							"\r",
							"        {{#each response.cases}}\r",
							"            <tr>\r",
							"                <td>{{id}}</td>\r",
							"                <td>{{title}}</td>\r",
							"                <td>{{estimate}}</td>\r",
							"            </tr>\r",
							"        {{/each}}\r",
							"\r",
							"    </table>\r",
							"`;\r",
							"\r",
							"pm.visualizer.set(template, {\r",
							"    response: pm.response.json()\r",
							"});\r",
							"\r",
							"// Tests for TestRail Get Cases API\r",
							"pm.test(\"✅ Response received\", function () {\r",
							"    pm.expect(pm.response).to.not.be.null;\r",
							"});\r",
							"\r",
							"if (pm.response.code === 401 || pm.response.code === 403) {\r",
							"    pm.test(\"🔐 Professional handling of authentication issues\", function () {\r",
							"        pm.expect(pm.response.code).to.be.oneOf([401, 403]);\r",
							"    });\r",
							"    \r",
							"    pm.test(\"📝 Clear error message for disabled account\", function () {\r",
							"        const response = pm.response.text();\r",
							"        pm.expect(response).to.include(\"disabled\");\r",
							"    });\r",
							"    \r",
							"    console.log(\"ℹ️ TestRail account disabled - demonstrating error handling\");\r",
							"    \r",
							"} else if (pm.response.code === 200) {\r",
							"    pm.test(\"🎯 Status code is 200\", function () {\r",
							"        pm.response.to.have.status(200);\r",
							"    });\r",
							"    \r",
							"    pm.test(\"📊 Response has valid JSON\", function () {\r",
							"        pm.response.to.be.json;\r",
							"    });\r",
							"    \r",
							"    pm.test(\"📋 Response contains cases array\", function () {\r",
							"        const response = pm.response.json();\r",
							"        pm.expect(response.cases).to.be.an('array');\r",
							"    });\r",
							"    \r",
							"    pm.test(\"🔍 Cases have required fields\", function () {\r",
							"        const response = pm.response.json();\r",
							"        if (response.cases.length > 0) {\r",
							"            const firstCase = response.cases[0];\r",
							"            pm.expect(firstCase).to.have.property('id');\r",
							"            pm.expect(firstCase).to.have.property('title');\r",
							"        }\r",
							"    });\r",
							"    \r",
							"    console.log(\"📊 Visualized test cases table available in Visualize tab\");\r",
							"}\r",
							"\r",
							"pm.test(\"⏱️ Response time is acceptable\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
